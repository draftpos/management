<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_management_helpdesk" model="ir.sequence">
            <field name="name">Help Desk Sequence</field>
            <field name="code">management.helpdesk</field>
            <field name="prefix">HD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_management_product" model="ir.sequence">
            <field name="name">Product Sequence</field>
            <field name="code">management.product</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

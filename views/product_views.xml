<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_product_tree" model="ir.ui.view">
        <field name="name">management.product.tree</field>
        <field name="model">management.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="item_code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_management_product_search" model="ir.ui.view">
        <field name="name">management.product.search</field>
        <field name="model">management.product</field>
        <field name="arch" type="xml">
            <search string="Products">
                <field name="item_code"/>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="view_management_product_form" model="ir.ui.view">
        <field name="name">management.product.form</field>
        <field name="model">management.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="item_code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_management_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">management.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_management_product"
              name="Products"
              parent="management_menu_configuration"
              action="action_management_product"
              sequence="10"/>
</odoo>

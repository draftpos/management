<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_job_tree" model="ir.ui.view">
        <field name="name">management.job.tree</field>
        <field name="model">management.job</field>
        <field name="arch" type="xml">
            <list string="Jobs" decoration-info="status == 'to_be_done'" decoration-warning="status == 'in_progress'" decoration-success="status == 'done'">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="sales_rep_ids" widget="many2many_tags"/>
                <field name="technician_ids" widget="many2many_tags"/>
                <field name="product_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_management_job_search" model="ir.ui.view">
        <field name="name">management.job.search</field>
        <field name="model">management.job</field>
        <field name="arch" type="xml">
            <search string="Jobs">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="sales_rep_ids"/>
                <field name="technician_ids"/>
                <field name="product_id"/>
                <field name="status"/>
                <field name="amount_quoted"/>
                <field name="next_contact_date"/>
                <field name="address_line"/>
                <field name="city"/>
                <field name="country_id"/>
                <group name="group_by">
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="Organization" name="group_by_org" context="{'group_by':'organization_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                    <filter string="Country" name="group_by_country" context="{'group_by':'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_management_job_form" model="ir.ui.view">
        <field name="name">management.job.form</field>
        <field name="model">management.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="to_be_done,in_progress,done,demo_scheduled" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Job Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="organization_id"/>
                            <field name="product_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_quoted" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Assignments">
                            <field name="sales_rep_ids" widget="many2many_tags"/>
                            <field name="technician_ids" widget="many2many_tags"/>
                            <field name="next_contact_date"/>
                        </group>
                        <group string="Address Details">
                            <field name="address_line"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_management_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">management.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_management_job"
              name="Jobs"
              parent="management_app_menu_root"
              action="action_management_job"
              sequence="10"/>
</odoo>

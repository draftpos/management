<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activity Type views -->
    <record id="view_management_activity_type_tree" model="ir.ui.view">
        <field name="name">management.activity.type.tree</field>
        <field name="model">management.activity.type</field>
        <field name="arch" type="xml">
            <list string="Activity Types">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_management_activity_type_form" model="ir.ui.view">
        <field name="name">management.activity.type.form</field>
        <field name="model">management.activity.type</field>
        <field name="arch" type="xml">
            <form string="Activity Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_management_activity_type" model="ir.actions.act_window">
        <field name="name">Activity Types</field>
        <field name="res_model">management.activity.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_management_activity_type"
              name="Activity Types"
              parent="management_menu_configuration"
              action="action_management_activity_type"
              sequence="20"/>

    <!-- Activity Performance views -->
    <record id="view_management_activity_performance_tree" model="ir.ui.view">
        <field name="name">management.activity.performance.tree</field>
        <field name="model">management.activity.performance</field>
        <field name="arch" type="xml">
            <list string="Activity Performance">
                <field name="activity_type_id"/>
                <field name="product_id"/>
                <field name="qty_done"/>
                <field name="expected_qty"/>
            </list>
        </field>
    </record>

    <record id="view_management_activity_performance_search" model="ir.ui.view">
        <field name="name">management.activity.performance.search</field>
        <field name="model">management.activity.performance</field>
        <field name="arch" type="xml">
            <search string="Activity Performance">
                <field name="activity_type_id"/>
                <field name="product_id"/>
                <field name="qty_done"/>
                <field name="expected_qty"/>
                <field name="leads_generated"/>
                <field name="unanswered_calls"/>
                <field name="leads_done"/>
                <group name="group_by">
                    <filter string="Activity Type" name="group_by_activity_type" context="{'group_by':'activity_type_id'}"/>
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_management_activity_performance_form" model="ir.ui.view">
        <field name="name">management.activity.performance.form</field>
        <field name="model">management.activity.performance</field>
        <field name="arch" type="xml">
            <form string="Activity Performance">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="activity_type_id"/>
                            <field name="activity_type_code" invisible="1"/>
                            <field name="product_id"/>
                            <field name="qty_done"/>
                            <field name="expected_qty"/>
                        </group>
                        <group string="Dynamic Metrics">
                            <field name="leads_generated" invisible="activity_type_code != 'cold_calls'"/>
                            <field name="unanswered_calls" invisible="activity_type_code not in ('cold_calls', 'calls_done')"/>
                            <field name="leads_done" invisible="activity_type_code != 'door_to_door'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_management_activity_performance" model="ir.actions.act_window">
        <field name="name">Activity Performance</field>
        <field name="res_model">management.activity.performance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_management_activity_performance_action"
              name="Activity Performance"
              parent="management_app_menu_root"
              action="action_management_activity_performance"
              sequence="40"/>
</odoo>

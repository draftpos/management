<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_sales_performance_tree" model="ir.ui.view">
        <field name="name">management.sales.performance.tree</field>
        <field name="model">management.sales.performance</field>
        <field name="arch" type="xml">
            <list string="Sales Performance">
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="sales_rep_id"/>
                <field name="value"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_management_sales_performance_search" model="ir.ui.view">
        <field name="name">management.sales.performance.search</field>
        <field name="model">management.sales.performance</field>
        <field name="arch" type="xml">
            <search string="Sales Performance">
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="sales_rep_id"/>
                <field name="value"/>
                <field name="company_id"/>
                <group name="group_by">
                    <filter string="Product" name="group_by_product" context="{'group_by':'product_id'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by':'customer_id'}"/>
                    <filter string="Sales Rep" name="group_by_sales_rep" context="{'group_by':'sales_rep_id'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_management_sales_performance_form" model="ir.ui.view">
        <field name="name">management.sales.performance.form</field>
        <field name="model">management.sales.performance</field>
        <field name="arch" type="xml">
            <form string="Sales Performance">
                <sheet>
                    <group>
                        <group string="Details">
                            <field name="customer_id"/>
                            <field name="product_id"/>
                            <field name="sales_rep_id"/>
                        </group>
                        <group string="Financials">
                            <field name="currency_id" invisible="1"/>
                            <field name="value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_management_sales_performance" model="ir.actions.act_window">
        <field name="name">Sales Performance</field>
        <field name="res_model">management.sales.performance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_management_sales_performance"
              name="Sales Performance"
              parent="management_app_menu_root"
              action="action_management_sales_performance"
              sequence="30"/>
</odoo>
